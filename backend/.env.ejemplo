# ---------------------------------------------------------------
# Variables del BACKEND de Dulce Arte (copiar como .env y completar)
#   cp .env.ejemplo .env   y luego   nano .env
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ---------------------------------------------------------------

# Clave secreta de Django y de los tokens JWT. Generar una nueva con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto
DEBUG=False

# IP elástica de la EC2 del backend (y localhost para pruebas dentro del servidor)
ALLOWED_HOSTS=IP_ELASTICA_BACKEND,localhost,127.0.0.1

# --- Base de datos: Amazon RDS (PostgreSQL) ---
DB_NAME=db_dulce_arte
DB_USER=dulce_admin
DB_PASSWORD=la-contraseña-de-rds
# El "Endpoint" que aparece en RDS > Databases > dulce-arte-db > Connectivity & security
DB_HOST=dulce-arte-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432

# --- Archivos: Amazon S3 ---
USAR_S3=True
AWS_STORAGE_BUCKET_NAME=nombre-de-tu-bucket
AWS_S3_REGION_NAME=us-east-1
# Etapa 5 (API Gateway): poner aquí el dominio de la API Gateway, SIN https:// ni barra final:
#   AWS_S3_CUSTOM_DOMAIN=abc123xyz.execute-api.us-east-1.amazonaws.com
# Mientras esté vacío, las imágenes se piden directo al bucket.
AWS_S3_CUSTOM_DOMAIN=

# --- API Gateway (Etapa 5) ---
# Cabecera secreta que la API Gateway agrega a cada petición. Vacío = desactivado.
GATEWAY_SECRETO=
# URL de la API Gateway (con https://), para que el Admin acepte sus formularios:
CSRF_TRUSTED_ORIGINS=
# Dirección del frontend (enlace "Ver el sitio" del Admin)
FRONTEND_URL=/
# La API Gateway atiende con HTTPS: activar en la Etapa 5
USAR_HTTPS=False

# --- Solo en tu computador (React en modo desarrollo) ---
CORS_ALLOWED_ORIGINS=
